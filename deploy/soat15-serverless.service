[Unit]
Description=SOAT15 Serverless Offline API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/soat15-serverless
EnvironmentFile=-/opt/soat15-serverless/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node /opt/soat15-serverless/node_modules/serverless/bin/serverless.js offline start
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target